+    db: AsyncSession = Depends(get_db),
+    user: User = Depends(get_current_user),
+):
+    """
+    To'liq karta raqami va CVV — FAQAT nusxa olish uchun.
+
+    Nima uchun kerak: ro'yxatda ("_card_out") raqam har doim
+    niqoblangan holda qaytariladi, ya'ni foydalanuvchi to'liq raqamni
+    hech qachon ko'ra olmaydi va ko'chirib bo'lmaydi. Frontenddagi
+    "Karta raqami" va "CVV" tugmalari shu endpoint orqali to'liq
+    qiymatni oladi va ALOHIDA nusxa qiladi.
+
+    XAVFSIZLIK:
+    · faqat kartaning EGASIGA (person.owner_id == user.id)
+    · "Raqamni yashirish" (mask_pan) sozlamasi yoqiq bo'lmasa,
+      ishchi/hamkor to'liq raqamni OLMAYDI — faqat egasi oladi
+    · har bir so'rov server logida qoladi
+    """
+    card = await db.get(Card, card_id)
+    if not card:
+        raise HTTPException(404, "Karta topilmadi")
+
+    person = await db.get(Person, card.person_id)
+    if not person or person.owner_id != user.id:
+        raise HTTPException(404, "Karta topilmadi")
+
+    # "Raqamni yashirish" sozlamasi
+    settings_row = (await db.execute(
+        select(UserSettings).where(UserSettings.owner_id == user.id)
+    )).scalars().first()
+    mask_pan = settings_row.mask_pan if settings_row else True
+
+    if mask_pan and user.role != Role.owner:
+        raise HTTPException(403, "To'liq karta raqamini faqat egasi ko'ra oladi")
+
+    try:
+        num = decrypt(card.number_enc)
+        cvv = decrypt(card.cvv_enc)
+    except Exception:
+        # PREMOLUX_ENC_KEY o'zgargan yoki yo'q bo'lgan bo'lishi mumkin
+        raise HTTPException(500, "Karta ma'lumotlari ochilmadi (shifrlash kaliti mos emas)")
+
+    print(f"[security] card #{card_id} to'liq ma'lumotlari "
+          f"tg_id={user.tg_id} role={user.role.value} tomonidan olindi")
+
+    return {
+        "id": card.id, "num": num, "cvv": cvv,
+        "exp": card.exp, "name": card.holder_name,
+    }
+
